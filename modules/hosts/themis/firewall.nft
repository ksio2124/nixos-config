   table inet filter {
        chain input {
          type filter hook input priority filter; policy drop;

          iifname "lo" accept
          ct state invalid drop
          ct state established,related accept

          icmpv6 type {
            destination-unreachable, packet-too-big, time-exceeded,
            parameter-problem, echo-request,
            nd-neighbor-solicit, nd-neighbor-advert,
            nd-router-solicit, nd-router-advert
          } accept

          iifname "wan" udp dport dhcpv6-client udp sport dhcpv6-server counter accept comment "Allow DHCPv6 client"
          iifname "br0" ether type arp accept
          iifname "br0" pkttype broadcast accept

          iifname "ve-*" ip daddr "10.0.0.5" accept
          iifname "ve-*" ip saddr "10.0.0.6" accept
          iifname "ve-*" ip saddr "10.0.0.14" accept
          iifname "ve-*" ip saddr "10.0.0.16" accept
          iifname "ve-*" drop
          icmp type echo-request accept

          iifname "br0" tcp dport { 80, 443} accept
          iifname "br0" udp dport { 53, 67, 68 } accept
          iifname "br0" tcp dport { 22 } accept comment "Allow ssh on br0"
          iifname "br0" udp dport {5353} accept comment "Allow Avahi mDNS"
          iifname "wan" tcp dport {80, 443} accept
          iifname "wan" udp dport {51820} accept
          iifname "br0" tcp dport {47984, 47989, 48010, 48011} accept comment "sunshine"
          iifname "br0" udp dport {47998, 47999, 48000, 48010, 48002} accept comment "sunshine"
          iifname "wg0" tcp dport {22} accept comment "Allow ssh via wireguard"
          iifname "podman*" udp dport {53} accept comment "Allow podman to get dns information"
          iifname "ve-*" udp dport {53} accept comment "Allow podman to get dns information"
          iifname "wan" meta l4proto { tcp, udp } th dport { 28967 } accept

        }

        chain forward {
          type filter hook forward priority filter; policy drop;

          ct state invalid drop
          ct state established,related accept
          iifname "br0" oifname "wan" accept
          iifname "br-isolated" oifname "wan" accept
          iifname "podman*" oifname "wan" accept comment "Allow podman internet access"
          iifname "wg0" oifname "wan" accept comment "Allow traffic from Wireguard to Internet"
            # Allow the WAN to send Storj traffic to the Podman bridge
          iifname "wan" oifname "podman*" tcp dport 28967 accept
          iifname "wan" oifname "podman*" udp dport 28967 accept
          iifname "wan" ip daddr "10.0.0.14" tcp dport { 25, 587, 993, 465, 4190 } accept
          iifname "ve-*" oifname "wan" accept
        }

        chain forward_mangle {
          type filter hook forward priority mangle;
          tcp flags syn tcp option maxseg size set rt mtu
        }
      }

      table ip nat {
        # Add this prerouting chain
          chain prerouting {
            type nat hook prerouting priority dstnat; policy accept;
            iifname "wan" tcp dport { 25, 587, 993, 465, 4190 } dnat to "10.0.0.14" 
            # Example: Forward external port 8080 to internal IP 10.0.0.5 on port 80
            #iifname "wan" tcp dport 28967 redirect to :443
          }
        chain postrouting {
          type nat hook postrouting priority srcnat;
          oifname "wan" masquerade
        }
      }


